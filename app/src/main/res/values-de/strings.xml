    <string name="sig_insulation_kohm">Isolationswiderstand</string>
    <string name="sig_insulation_kohm_expl">Widerstand zwischen Hochvoltbatterie und Fahrzeugkarosserie. Höher ist besser. Unter ca. 180 kΩ ist er niedrig; unter ca. 36 kΩ beendet das Batteriemanagement die Ladung. Manche Ladesäulen lassen den Wert stark schwanken.</string>
    <string name="sig_insulation_fault">Isolationsfehler-Flag</string>
    <string name="sig_bms_state">BMS-Zustand</string>
    <string name="sig_bms_state_expl">0x06 eingesteckt, 0x15 AC-Laden, 0x16 DC-Laden, 0x1A DC-Ladung beendet, 0x12 vom BMS gestoppt.</string>
    <string name="sig_hv_flags">Hochvolt-Status</string>
    <string name="sig_hv_flags_expl">Bit 0x04 gesetzt: Hochvolt-Schütze geschlossen (READY oder Laden). Bit 0x10: Warnung niedriger Ladestand.</string>
    <string name="sig_charge_counter">Insgesamt geladene Energie</string>
    <string name="sig_charge_counter_expl">Alle über die Lebensdauer in den Akku geladene Energie, AC und DC, in 2-kWh-Schritten. Fahren und Rekuperation zählen nicht.</string>
    <string name="sig_disch_limit_kw">Entladeleistung laut BMS</string>
    <string name="sig_disch_limit_kw_expl">Keine harte Grenze: Beim Beschleunigen wird deutlich mehr entnommen (bis ~90 kW beobachtet). Der Wert ist das Entladestrom-Limit des BMS × Akkuspannung und sinkt, wenn das BMS dieses Limit bei niedrigem Ladestand senkt.</string>
    <string name="sig_regen_limit_kw">Rekuperationsleistungs-Limit</string>
    <string name="sig_charge_current_600">Ladestrom (BMS-Status)</string>
    <string name="sig_charge_minutes_600">Ladedauer (BMS-Status)</string>
    <string name="sig_dc_link_v">Zwischenkreisspannung Wechselrichter</string>
    <string name="sig_dc_link_v_expl">Ca. 340 V bei eingeschalteter Hochvolt-Anlage; sinkt nach dem Ausschalten.</string>
    <string name="sig_v12">12-V-Batterie</string>
    <string name="sig_v12_expl">Etwa 12,4 V bei Zündung an, ca. 13,9 V bei READY (der DC-DC-Wandler lädt die 12-V-Batterie).</string>
