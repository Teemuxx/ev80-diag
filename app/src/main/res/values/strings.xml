    <string name="sig_insulation_kohm">Insulation resistance</string>
    <string name="sig_insulation_kohm_expl">Resistance between the high-voltage battery and the van\'s body. Higher is better. Under about 180 kΩ it is low; under about 36 kΩ the battery management stops the charge. Some chargers make this value swing.</string>
    <string name="sig_insulation_fault">Insulation fault flag</string>
    <string name="sig_bms_state">BMS state</string>
    <string name="sig_bms_state_expl">0x06 plugged, 0x15 AC charging, 0x16 DC charging, 0x1A DC charge complete, 0x12 stopped by the BMS.</string>
    <string name="sig_hv_flags">High-voltage flags</string>
    <string name="sig_hv_flags_expl">Bit 0x04 set: high-voltage contactors closed (READY or charging). Bit 0x10: low-charge flag.</string>
    <string name="sig_charge_counter">Lifetime energy charged</string>
    <string name="sig_charge_counter_expl">All energy charged into the battery over the van\'s life, AC and DC, in 2 kWh steps. Driving and regeneration do not count.</string>
    <string name="sig_disch_limit_kw">Discharge power rating (BMS)</string>
    <string name="sig_disch_limit_kw_expl">Not a hard limit: acceleration can draw far more (up to ~90 kW seen). It equals the BMS discharge current limit × pack voltage and drops when the BMS lowers that limit at low charge.</string>
    <string name="sig_regen_limit_kw">Regeneration power limit</string>
    <string name="sig_charge_current_600">Charge current (BMS status)</string>
    <string name="sig_charge_minutes_600">Charge time (BMS status)</string>
    <string name="sig_dc_link_v">Inverter DC-link voltage</string>
    <string name="sig_dc_link_v_expl">About 340 V when the high voltage is on; it decays after the van is switched off.</string>
    <string name="sig_v12">12 V battery</string>
    <string name="sig_v12_expl">Around 12.4 V with ignition on, about 13.9 V when READY (the DC-DC converter charges the 12 V battery).</string>
